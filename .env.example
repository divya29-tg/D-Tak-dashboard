# Environment Variables Template for Dtak Admin Dashboard

# Base URL for backend API integration
# For local dev proxy: VITE_API_BASE_URL=/api/admin
# For direct production server: VITE_API_BASE_URL=https://dchat.staging.trustgrid.com/api/admin
VITE_API_BASE_URL=/api/admin

# Local Development Authentication Credentials (Placeholders)
VITE_LOCAL_ADMIN_ID=admin123
VITE_LOCAL_ADMIN_PIN=your_6_digit_pin_here

# MapTiler API Key
VITE_MAPTILER_API_KEY=


# NCC backend (KPI counts)
VITE_NCC_API_BASE_URL=https://nccbackend.staging.trustgrid.com
VITE_NCC_NETWORK_ID=76
VITE_NCC_TOKEN=
VITE_NCC_EXPLORER_URL=https://explorer.staging.trustgrid.com
VITE_NCC_EXPLORER_LEDGER=TrustGridDev
